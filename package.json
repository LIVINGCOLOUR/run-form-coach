{
  "name": "run-form-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-wasm": "mkdir -p public/mediapipe && cp node_modules/@mediapipe/tasks-vision/wasm/* public/mediapipe/",
    "predev": "npm run copy-wasm",
    "prebuild": "npm run copy-wasm",
    "dev": "vite --host",
    "dev:https": "npm run copy-wasm && vite --config vite.https.config.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "voices": "node scripts/gen-voices.mjs",
    "compare": "node scripts/compare-runs.mjs",
    "logs": "node scripts/fetch-logs.mjs",
    "drill": "node scripts/treadmill-drill.mjs",
    "grade": "node scripts/treadmill-grade.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vercel/blob": "2.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
