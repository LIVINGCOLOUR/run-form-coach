{
  "name": "run-form-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-wasm": "mkdir -p public/mediapipe && cp node_modules/@mediapipe/tasks-vision/wasm/* public/mediapipe/",
    "predev": "npm run copy-wasm",
    "prebuild": "npm run copy-wasm",
    "dev": "vite --host",
    "dev:https": "npm run copy-wasm && vite --config vite.https.config.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "voices": "node scripts/gen-voices.mjs",
    "compare": "node scripts/compare-runs.mjs",
    "compare:sensor": "node scripts/compare-sensor-camera.mjs",
    "replay:sensor": "node scripts/replay-sensor.mjs",
    "logs": "node scripts/fetch-logs.mjs",
    "drill": "node scripts/treadmill-drill.mjs",
    "drill:short": "node scripts/treadmill-drill.mjs --walk 120 --upright 90 --first 240 --steps heel --sec 60 --gap 30 --speeds 9,10 --speed-sec 150 --jog 870 --moved 0 --cool 120 --hr 0",
    "drill:pose": "node scripts/treadmill-drill.mjs --poses 60 --walk 0 --upright 0 --first 180 --steps hunch,hunch,open,open,head,head --sec 20 --gap 40 --speeds none --jog 600 --moved 0 --cool 120 --hr 0",
    "grade": "node scripts/treadmill-grade.mjs",
    "rec:landmarks": "node scripts/rec-landmarks.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vercel/blob": "2.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
